import { Button, LineEdit, Palette, ScrollView, Slider } from "std-widgets.slint";

export global StudioTheme {
    in-out property <bool> dark_mode: false;
    out property <color> canvas: dark_mode ? #131a18 : #eef0e9;
    out property <color> sidebar: dark_mode ? #1a2421 : #f8f9f4;
    out property <color> surface: dark_mode ? #222e2a : #ffffff;
    out property <color> paper: dark_mode ? #ded8c8 : #f5f1e6;
    out property <color> text: dark_mode ? #e6ece7 : #25312c;
    out property <color> muted: dark_mode ? #a6b3ab : #5e6b63;
    out property <color> border: dark_mode ? #3a4942 : #d6ddd4;
    out property <color> accent: dark_mode ? #df8b65 : #9b4c35;
    out property <color> preview_well: dark_mode ? #111715 : #e2e5dd;
}

component SectionTitle inherits Text {
    color: StudioTheme.accent;
    font-size: 12px;
    font-weight: 700;
}

component SettingSlider inherits VerticalLayout {
    in property <string> label;
    in property <float> minimum;
    in property <float> maximum;
    in-out property <float> value;
    spacing: 3px;

    HorizontalLayout {
        Text {
            text: root.label;
            color: StudioTheme.muted;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            color: StudioTheme.text;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    Slider {
        minimum: root.minimum;
        maximum: root.maximum;
        value <=> root.value;
    }
}

component PathInput inherits VerticalLayout {
    in property <string> label;
    in-out property <string> path;
    callback browse();
    spacing: 5px;

    Text {
        text: root.label;
        color: StudioTheme.muted;
    }
    HorizontalLayout {
        spacing: 8px;
        LineEdit {
            text <=> root.path;
            accessible-label: root.label;
            horizontal-stretch: 1;
            height: 34px;
        }
        Button {
            text: "Browse";
            width: 76px;
            clicked => { root.browse(); }
        }
    }
}

component PreviewPath inherits HorizontalLayout {
    in property <string> accessible_name;
    in-out property <string> path;
    callback browse();
    spacing: 6px;

    LineEdit {
        text <=> root.path;
        accessible-label: root.accessible_name;
        horizontal-stretch: 1;
        height: 32px;
    }
    Button {
        text: "Browse";
        width: 68px;
        clicked => { root.browse(); }
    }
}

component TextureAssetRow inherits HorizontalLayout {
    in property <string> label;
    in property <image> preview;
    in-out property <string> path;
    callback browse();
    spacing: 8px;

    VerticalLayout {
        width: 92px;
        spacing: 4px;
        Text { text: root.label; color: StudioTheme.muted; font-size: 10px; }
        Rectangle {
            width: 100%;
            height: 46px;
            background: StudioTheme.surface;
            border-width: 1px;
            border-color: StudioTheme.border;
            clip: true;
            Image { width: 100%; height: 100%; source: root.preview; image-fit: cover; }
        }
    }
    PreviewPath {
        accessible_name: root.label;
        path <=> root.path;
        browse => { root.browse(); }
    }
}

component FontAssetRow inherits VerticalLayout {
    in property <string> label;
    in property <image> preview;
    in-out property <string> path;
    callback browse();
    spacing: 4px;

    Text { text: root.label; color: StudioTheme.muted; font-size: 10px; }
    Rectangle {
        width: 100%;
        height: 38px;
        background: StudioTheme.paper;
        border-width: 1px;
        border-color: StudioTheme.border;
        clip: true;
        Image { width: 100%; height: 100%; source: root.preview; image-fit: contain; }
    }
    PreviewPath {
        accessible_name: root.label;
        path <=> root.path;
        browse => { root.browse(); }
    }
}

export component MainWindow inherits Window {
    title: "Secret Ink | Document Studio";
    width: 1360px;
    height: 900px;
    background: StudioTheme.canvas;

    in-out property <string> input_path;
    in-out property <string> output_path;
    in-out property <string> default_font;
    in-out property <string> heading_font;
    in-out property <string> stamp_font;
    in-out property <string> paper_albedo;
    in-out property <string> paper_normal;
    in-out property <string> paper_roughness;
    in-out property <string> redaction_marker;
    in-out property <string> stamp_marker;

    in-out property <float> page_width;
    in-out property <float> page_height;
    in-out property <float> margin_top;
    in-out property <float> margin_bottom;
    in-out property <float> margin_left;
    in-out property <float> margin_right;
    in-out property <float> letter_spacing;
    in-out property <float> line_spacing;
    in-out property <float> font_size;
    in-out property <float> heading_size;
    in-out property <float> stamp_size;
    in-out property <float> jitter_px;
    in-out property <float> blur_sigma;
    in-out property <float> ink_opacity;

    in property <image> albedo_preview;
    in property <image> normal_preview;
    in property <image> roughness_preview;
    in property <image> default_font_preview;
    in property <image> heading_font_preview;
    in property <image> stamp_font_preview;
    in property <image> result_preview;
    in property <bool> has_preview;
    in property <bool> working;
    in property <string> status_text;

    callback browse_file(string);
    callback load_profile();
    callback save_profile();
    callback preview_document();
    callback render_document();
    callback open_output();

    init => {
        Palette.color-scheme = ColorScheme.light;
    }

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 68px;
            background: #1c302f;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "SECRET INK";
                        color: #f0ece0;
                        font-size: 23px;
                        font-weight: 700;
                    }
                    Text {
                        text: "DOCUMENT STUDIO";
                        color: #b6c1b8;
                        font-size: 10px;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: StudioTheme.dark_mode ? "Light mode" : "Dark mode";
                    clicked => {
                        StudioTheme.dark_mode = !StudioTheme.dark_mode;
                        Palette.color-scheme = StudioTheme.dark_mode ? ColorScheme.dark : ColorScheme.light;
                    }
                }
                Button {
                    text: "Load profile";
                    clicked => { root.load_profile(); }
                }
                Button {
                    text: "Save profile";
                    clicked => { root.save_profile(); }
                }
            }
        }

        HorizontalLayout {
            spacing: 0px;

            Rectangle {
                width: 380px;
                background: StudioTheme.sidebar;
                ScrollView {
                    width: 100%;
                    height: 100%;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;

                        SectionTitle { text: "DOCUMENT"; }
                        PathInput {
                            label: "Markdown source";
                            path <=> root.input_path;
                            browse => { root.browse_file("input"); }
                        }
                        PathInput {
                            label: "Rendered image";
                            path <=> root.output_path;
                            browse => { root.browse_file("output"); }
                        }

                        Rectangle { height: 1px; background: StudioTheme.border; }
                        SectionTitle { text: "PAGE"; }
                        SettingSlider { label: "Width (px)"; minimum: 512; maximum: 5000; value <=> root.page_width; }
                        SettingSlider { label: "Height (px)"; minimum: 512; maximum: 5000; value <=> root.page_height; }
                        SettingSlider { label: "Top margin"; minimum: 0; maximum: 500; value <=> root.margin_top; }
                        SettingSlider { label: "Bottom margin"; minimum: 0; maximum: 500; value <=> root.margin_bottom; }
                        SettingSlider { label: "Left margin"; minimum: 0; maximum: 500; value <=> root.margin_left; }
                        SettingSlider { label: "Right margin"; minimum: 0; maximum: 500; value <=> root.margin_right; }

                        Rectangle { height: 1px; background: StudioTheme.border; }
                        SectionTitle { text: "TYPE & INK"; }
                        SettingSlider { label: "Letter spacing"; minimum: 1; maximum: 80; value <=> root.letter_spacing; }
                        SettingSlider { label: "Line spacing"; minimum: 1; maximum: 100; value <=> root.line_spacing; }
                        SettingSlider { label: "Body size"; minimum: 6; maximum: 100; value <=> root.font_size; }
                        SettingSlider { label: "Heading size"; minimum: 12; maximum: 180; value <=> root.heading_size; }
                        SettingSlider { label: "Stamp size"; minimum: 12; maximum: 180; value <=> root.stamp_size; }
                        SettingSlider { label: "Ink jitter"; minimum: 0; maximum: 20; value <=> root.jitter_px; }
                        SettingSlider { label: "Ink blur"; minimum: 0; maximum: 5; value <=> root.blur_sigma; }
                        SettingSlider { label: "Ink opacity"; minimum: 0; maximum: 1; value <=> root.ink_opacity; }

                        Rectangle { height: 1px; background: StudioTheme.border; }
                        SectionTitle { text: "MARKERS"; }
                        VerticalLayout {
                            spacing: 5px;
                            Text { text: "Redaction"; color: StudioTheme.muted; }
                            LineEdit { text <=> root.redaction_marker; height: 34px; }
                        }
                        VerticalLayout {
                            spacing: 5px;
                            Text { text: "Stamp"; color: StudioTheme.muted; }
                            LineEdit { text <=> root.stamp_marker; height: 34px; }
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: StudioTheme.canvas;
                VerticalLayout {
                    padding: 22px;
                    spacing: 14px;

                    HorizontalLayout {
                        VerticalLayout {
                            spacing: 3px;
                            Text {
                                text: "Render preview";
                                color: StudioTheme.text;
                                font-size: 22px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Proof the page, paper, and type before export";
                                color: StudioTheme.muted;
                                font-size: 13px;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: "Update preview";
                            enabled: !root.working;
                            clicked => { root.preview_document(); }
                        }
                        Button {
                            text: root.working ? "Rendering..." : "Render full size";
                            enabled: !root.working;
                            clicked => { root.render_document(); }
                        }
                    }

                    Rectangle { height: 1px; background: StudioTheme.border; }
                    SectionTitle { text: "PAPER TEXTURES"; }
                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 16px;

                        ScrollView {
                            width: 390px;
                            height: 100%;
                            VerticalLayout {
                                spacing: 9px;

                                SectionTitle { text: "PAPER MAPS"; }
                                TextureAssetRow {
                                    label: "COLOR";
                                    preview: root.albedo_preview;
                                    path <=> root.paper_albedo;
                                    browse => { root.browse_file("paper_albedo"); }
                                }
                                TextureAssetRow {
                                    label: "NORMAL";
                                    preview: root.normal_preview;
                                    path <=> root.paper_normal;
                                    browse => { root.browse_file("paper_normal"); }
                                }
                                TextureAssetRow {
                                    label: "ROUGHNESS";
                                    preview: root.roughness_preview;
                                    path <=> root.paper_roughness;
                                    browse => { root.browse_file("paper_roughness"); }
                                }

                                Rectangle { height: 1px; background: StudioTheme.border; }
                                SectionTitle { text: "TYPEFACES"; }
                                FontAssetRow {
                                    label: "BODY";
                                    preview: root.default_font_preview;
                                    path <=> root.default_font;
                                    browse => { root.browse_file("default_font"); }
                                }
                                FontAssetRow {
                                    label: "HEADING";
                                    preview: root.heading_font_preview;
                                    path <=> root.heading_font;
                                    browse => { root.browse_file("heading_font"); }
                                }
                                FontAssetRow {
                                    label: "STAMP";
                                    preview: root.stamp_font_preview;
                                    path <=> root.stamp_font;
                                    browse => { root.browse_file("stamp_font"); }
                                }
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 10px;
                            HorizontalLayout {
                                SectionTitle { text: "FINAL IMAGE"; }
                                Rectangle { horizontal-stretch: 1; }
                                Button {
                                    text: "Open image";
                                    enabled: !root.working && root.has_preview;
                                    clicked => { root.open_output(); }
                                }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                background: StudioTheme.preview_well;
                                border-width: 1px;
                                border-color: StudioTheme.border;
                                clip: true;
                                Image {
                                    width: 100%;
                                    height: 100%;
                                    source: root.result_preview;
                                    image-fit: contain;
                                    visible: root.has_preview;
                                }
                                if (!root.has_preview): Text {
                                    text: "Render a preview to see the finished page";
                                    color: StudioTheme.muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: root.status_text;
                                color: StudioTheme.muted;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }
}
