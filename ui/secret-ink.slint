import { Palette } from "std-widgets.slint";
import { StudioTheme } from "common.slint";
import { StudioHeader } from "header.slint";
import { SettingsPanel } from "settings-panel.slint";
import { StudioWorkspace } from "workspace.slint";

export { StudioConfig, StudioState, StudioViewState } from "common.slint";

export component MainWindow inherits Window {
    title: "Secret Ink | Document Studio";
    width: 1360px;
    height: 900px;
    background: StudioTheme.canvas;

    callback browse_file(string);
    callback load_profile();
    callback save_profile();
    callback preview_document();
    callback render_document();
    callback open_output();
    callback previous_preview_page();
    callback next_preview_page();

    init => {
        Palette.color-scheme = ColorScheme.light;
    }

    VerticalLayout {
        spacing: 0px;

        StudioHeader {
            load_profile => { root.load_profile(); }
            save_profile => { root.save_profile(); }
        }

        HorizontalLayout {
            spacing: 0px;

            SettingsPanel {
                width: 380px;
                browse_file(path) => { root.browse_file(path); }
            }

            StudioWorkspace {
                horizontal-stretch: 1;
                browse_file(path) => { root.browse_file(path); }
                preview_document => { root.preview_document(); }
                render_document => { root.render_document(); }
                open_output => { root.open_output(); }
                previous_preview_page => { root.previous_preview_page(); }
                next_preview_page => { root.next_preview_page(); }
            }
        }
    }
}
